{
  "name": "@pdfcraft/api",
  "version": "0.1.0",
  "private": true,
  "description": "PDF manipulation API for pdfcraft",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:ci": "vitest run",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^8.5.0",
    "@fastify/multipart": "^8.0.0",
    "@pdfcraft/types": "workspace:*",
    "dotenv": "^16.3.1",
    "fastify": "^4.25.2",
    "pdf-lib": "^1.17.1",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@pdfcraft/config": "workspace:*",
    "@types/node": "^20.10.4",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0"
  }
}
